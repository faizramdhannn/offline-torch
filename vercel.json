{
  "regions": ["sin1"],
  "crons": [
    { "path": "/api/cron/catalog-refresh", "schedule": "0 3 * * *" },
    { "path": "/api/cron/users-backup", "schedule": "30 20 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "ALLOW-FROM https://offline-tracking.vercel.app/"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://offline-tracking.vercel.app/"
        }
      ]
    }
  ]
}